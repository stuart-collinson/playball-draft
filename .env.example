# Auth (add your provider secrets here)
# AUTH_SECRET=

# Database (add your connection string here)
# DATABASE_URL=

# FPL edge-cache header logging (x-cache/age/edge-control) per fetch. ON by
# default so the first live gameweek can be measured. Set to 0 to silence it
# once the SERVER_TTL values have been tuned.
# FPL_LOG_CACHE=0
